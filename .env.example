# ── Groq (message parsing) ───────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
WHATSAPP_TOKEN=           # Permanent token from Meta System User
WHATSAPP_PHONE_ID=        # Phone Number ID from Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=    # Any string you choose — used to verify webhook
MY_WHATSAPP_NUMBER=       # Your number in international format, no + (e.g. 94771234567)

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=         # Token from @BotFather
MY_TELEGRAM_CHAT_ID=        # Your personal chat ID (get from @userinfobot)
TELEGRAM_SECRET_TOKEN=      # Optional: any random string for webhook security

# ── SMS ingest (iOS Shortcut → POST /api/sms-ingest) ─────────────────────────
SMS_INGEST_SECRET=          # Shared secret sent as the X-SMS-Secret header
OWN_HNB_ACCOUNTS=           # Comma-separated HNB account numbers. Stored masked. Transfers between them are not expenses.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
TZ=Asia/Colombo   # Ensures dates use Sri Lanka time (UTC+5:30)
